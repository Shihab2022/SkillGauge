datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

// ----------------------------- Enums -----------------------------

enum UserRole {
  CANDIDATE
  RECRUITER
  /// Company owner/administrator — can create a company and manage its recruiters.
  /// Treated as a recruiter (scoped to their company) with extra company-management access.
  COMPANY
  ADMIN
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProblemType {
  CODING
  MCQ
  WRITTEN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  COMPLETED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EVALUATING
  COMPLETED
  EXPIRED
}

enum SubmissionStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  PARTIAL
  ERROR
  MANUAL_REVIEW
  COMPLETED
}

enum EvaluationStatus {
  PENDING
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum CreditTransactionType {
  CREDIT
  DEBIT
}

enum AntiCheatingEventType {
  TAB_SWITCH
  WINDOW_BLUR
  WINDOW_FOCUS
  FULLSCREEN_EXIT
  COPY
  PASTE
  MULTIPLE_SESSION
  SUSPICIOUS_ACTIVITY
}

enum AssessmentAccessLevel {
  PUBLIC
  PRIVATE
  INVITATION_ONLY
  ACCESS_CODE
}

enum ResultStrategy {
  BEST_SCORE
  LATEST_SCORE
  FIRST_SCORE
}

enum RecruitmentStatus {
  INVITED
  STARTED
  COMPLETED
  SHORTLISTED
  INTERVIEW
  HIRED
  REJECTED
}

enum CreditTransactionCategory {
  CREDIT_PURCHASE
  INVITATION_USAGE
  REFUND
  ADMIN_ADJUSTMENT
  EXPIRATION
}

enum NotificationType {
  ASSESSMENT_INVITATION
  ASSESSMENT_COMPLETED
  RESULT_AVAILABLE
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  ASSESSMENT_EXPIRING
}

enum NotificationStatus {
  UNREAD
  READ
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ----------------------------- Video interview enums -----------------------------

enum InterviewStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum InterviewSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  PROCESSING
  REVIEWED
  TERMINATED
}

enum InterviewQuestionSource {
  BANK
  CUSTOM
}

enum InterviewViolationType {
  TAB_SWITCH
  WINDOW_BLUR
  FULLSCREEN_EXIT
  MULTIPLE_FACES
  DEVICE_DETECTED
  NOISE_DETECTED
  FACE_NOT_VISIBLE
  CAMERA_BLOCKED
  MICROPHONE_BLOCKED
  LOOKING_AWAY
  COPY
  PASTE
}

enum InterviewViolationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InterviewViolationDetector {
  CLIENT
  AI
  RECRUITER
}

enum InterviewDecision {
  STRONG_HIRE
  HIRE
  MAYBE
  NO_HIRE
}

// ----------------------------- Models -----------------------------

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  name            String
  password        String
  role            UserRole   @default(CANDIDATE)
  status          UserStatus @default(ACTIVE)
  /// Email confirmation — a user must confirm their address before signing in.
  emailVerified   Boolean    @default(false)
  emailVerifiedAt DateTime?
  phone           String?
  bio             String?
  skills          String[]   @default([])
  experience      Int?
  education       Json?
  profileImageUrl String?
  resumeUrl       String?
  jobTitle        String?
  companyId       String?
  company         Company?   @relation("Employer", fields: [companyId], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  memberships        CompanyMember[]
  problems           Problem[]       @relation("ProblemCreator")
  assessmentsCreated Assessment[]    @relation("AssessmentCreator")
  invitationsSent    Invitation[]    @relation("InvitationSender")
  invitations        Invitation[]    @relation("InvitedCandidate")
  attempts           Attempt[]
  submissions        Submission[]
  results            Result[]
  payments           Payment[]
  evaluations        Evaluation[]    @relation("Evaluator")
  auditLogs          AuditLog[]
  notesAuthored      CandidateNote[] @relation("NoteAuthor")
  notifications      Notification[]
  templatesCreated  AssessmentTemplate[]
  candidateNotes    CandidateNote[]
  interviewsCreated Interview[]       @relation("InterviewCreator")
  interviewSessions InterviewSession[] @relation("InterviewCandidate")

  resumes          Resume[]
  jobDescriptions  JobDescription[]
  resumeAnalyses   ResumeAnalysis[]

  @@index([role])
  @@index([status])
  @@index([companyId])
}

model RefreshToken {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedByToken String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

/// Single-use, hashed token for email confirmation and password reset.
model VerificationToken {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String                @unique
  type      VerificationTokenType @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId])
  @@index([type])
}

model Company {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  /// Short, human-friendly join code recruiters use instead of the raw company id.
  code        String?   @unique
  logo        String?
  description String?
  website     String?
  industry    String?
  location    String?
  size        String?
  credits     Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members            CompanyMember[]
  users              User[]              @relation("Employer")
  problems           Problem[]
  assessments        Assessment[]
  invitations        Invitation[]
  attempts           Attempt[]
  payments           Payment[]
  creditTransactions CreditTransaction[]
  templates          AssessmentTemplate[]
  candidateNotes     CandidateNote[]
  interviews         Interview[]

  @@index([name])
}

model CompanyMember {
  id        String            @id @default(uuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CompanyMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([companyId, userId])
  @@index([userId])
}

model Problem {
  id             String        @id @default(uuid())
  title          String
  description    String
  type           ProblemType
  difficulty     Difficulty    @default(MEDIUM)
  category       String?
  points         Int           @default(10)
  timeLimit      Int?
  memoryLimit    Int?
  expectedAnswer Json?
  createdBy      String
  creator        User          @relation("ProblemCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status         ProblemStatus @default(DRAFT)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Advanced question bank fields
  skills           String[]   @default([])
  allowedLanguages String[]   @default([])
  version         Int         @default(1)
  examples         Json?
  timesUsed       Int         @default(0)
  timesAttempted  Int         @default(0)
  timesSolved     Int         @default(0)
  successRate     Float       @default(0)
  averageScore    Float       @default(0)

  tags               ProblemTag[]
  testCases          CodingTestCase[]
  options            MCQOption[]
  assessmentProblems AssessmentProblem[]
  attemptAnswers     AttemptAnswer[]
  submissions        Submission[]
  evaluations        Evaluation[]
  resultItems        ResultItem[]

  @@index([type])
  @@index([difficulty])
  @@index([category])
  @@index([status])
  @@index([companyId])
  @@index([createdBy])
}

model ProblemTag {
  id        String   @id @default(uuid())
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([problemId, name])
  @@index([name])
}

model CodingTestCase {
  id             String  @id @default(uuid())
  problemId      String
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  isHidden       Boolean @default(false)
  order          Int     @default(0)

  @@index([problemId])
}

model MCQOption {
  id        String  @id @default(uuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  @@index([problemId])
}

model Assessment {
  id                  String           @id @default(uuid())
  companyId           String
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy           String
  creator             User             @relation("AssessmentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  title               String
  description         String?
  instructions        String?
  durationMinutes     Int
  passingScore        Int              @default(0)
  status              AssessmentStatus @default(DRAFT)
  startDate           DateTime?
  endDate             DateTime?
  maxAttempts         Int              @default(1)
  shuffleProblems     Boolean          @default(false)
  showResults         Boolean          @default(true)
  antiCheatingEnabled Boolean          @default(true)
  resultStrategy     ResultStrategy     @default(LATEST_SCORE)
  accessLevel        AssessmentAccessLevel @default(INVITATION_ONLY)
  accessCodeHash     String?
  shuffleOptions     Boolean          @default(false)
  questionConfig     Json?
  templateId         String?
  showCandidateRanking Boolean         @default(true)
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  problems    AssessmentProblem[]
  invitations Invitation[]
  attempts    Attempt[]
  submissions Submission[]
  results     Result[]
  template    AssessmentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  candidateNotes CandidateNote[]

  @@index([companyId])
  @@index([createdBy])
  @@index([status])
}

model AssessmentProblem {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  problemId    String
  problem      Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  order        Int        @default(0)
  points       Int
  isRequired   Boolean    @default(true)
  section      String?

  @@unique([assessmentId, problemId])
  @@index([assessmentId])
  @@index([problemId])
}

model Invitation {
  id           String           @id @default(uuid())
  assessmentId String
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidateId  String?
  candidate    User?            @relation("InvitedCandidate", fields: [candidateId], references: [id], onDelete: SetNull)
  companyId    String?
  company      Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  email        String
  status       InvitationStatus @default(PENDING)
  recruitmentStatus RecruitmentStatus @default(INVITED)
  token        String?
  invitedBy    String?
  inviter      User?            @relation("InvitationSender", fields: [invitedBy], references: [id], onDelete: SetNull)
  invitedAt    DateTime         @default(now())
  expiresAt    DateTime?
  acceptedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assessmentId, email])
  @@index([assessmentId])
  @@index([candidateId])
  @@index([email])
}

model Attempt {
  id            String        @id @default(uuid())
  assessmentId  String
  assessment    Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     User          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  attemptNumber Int           @default(1)
  status        AttemptStatus @default(NOT_STARTED)
  startedAt     DateTime?
  expiresAt     DateTime?
  submittedAt   DateTime?
  score         Int?
  maxScore      Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  shuffledQuestionOrder Json?
  shuffledOptions    Json?
  sessions           AttemptSession[]
  answers            AttemptAnswer[]
  submissions        Submission[]
  antiCheatingEvents AntiCheatingEvent[]
  evaluations        Evaluation[]
  result             Result?

  @@unique([assessmentId, candidateId, attemptNumber])
  @@index([candidateId])
  @@index([assessmentId])
}

model AttemptAnswer {
  id                  String    @id @default(uuid())
  attemptId           String
  attempt             Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  problemId           String
  problem             Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  answer              Json?
  code                String?   @db.Text
  programmingLanguage String?
  submittedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([attemptId, problemId])
  @@index([attemptId])
}

model Submission {
  id                  String           @id @default(uuid())
  attemptId           String
  attempt             Attempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  candidateId         String
  candidate           User             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessmentId        String
  assessment          Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  problemId           String
  problem             Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  code                String?          @db.Text
  programmingLanguage String?
  status              SubmissionStatus @default(PENDING)
  submittedAt         DateTime         @default(now())
  score               Int?
  executionTime       Int?
  memoryUsed          Int?
  evaluationResult    Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  evaluations Evaluation[]
  resultItems ResultItem[]

  @@index([attemptId])
  @@index([candidateId])
  @@index([assessmentId])
  @@index([problemId])
}

model Evaluation {
  id           String           @id @default(uuid())
  submissionId String?
  submission   Submission?      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  attemptId    String
  attempt      Attempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  problemId    String
  problem      Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  type         ProblemType
  status       EvaluationStatus @default(PENDING)
  score        Int?
  maxScore     Int?
  feedback     String?
  evaluatorId  String?
  evaluator    User?            @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: SetNull)
  evaluatedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([attemptId])
  @@index([submissionId])
}

model Result {
  id               String     @id @default(uuid())
  attemptId        String     @unique
  attempt          Attempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        User       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessmentId     String
  assessment       Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  totalPoints      Int
  earnedPoints     Int
  percentage       Float
  passed           Boolean
  timeTakenSeconds Int?
  releasedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  rank       Int?
  items       ResultItem[]

  @@index([candidateId])
  @@index([assessmentId])
}

model ResultItem {
  id           String      @id @default(uuid())
  resultId     String
  result       Result      @relation(fields: [resultId], references: [id], onDelete: Cascade)
  problemId    String
  problem      Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  points       Int
  earnedPoints Int
  status       String?
  feedback     String?
  createdAt    DateTime    @default(now())

  @@index([resultId])
  @@index([problemId])
}

model AntiCheatingEvent {
  id        String                @id @default(uuid())
  attemptId String
  attempt   Attempt               @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  eventType AntiCheatingEventType
  metadata  Json?
  ipAddress String?
  userAgent String?
  timestamp DateTime              @default(now())
  createdAt DateTime              @default(now())

  @@index([attemptId])
}

model Payment {
  id                   String          @id @default(uuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  companyId            String?
  company              Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  packageId            String?
  package              PaymentPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  transactionId        String          @unique
  amount               Int
  currency             String          @default("BDT")
  status               PaymentStatus   @default(PENDING)
  gateway              String          @default("SSLCOMMERZ")
  gatewayTransactionId String?
  metadata             Json?
  paidAt               DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  creditTransactions CreditTransaction[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model PaymentPackage {
  id          String   @id @default(uuid())
  name        String
  credits     Int
  price       Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]
}

model CreditTransaction {
  id          String                @id @default(uuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paymentId   String?
  payment     Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  credits     Int
  type        CreditTransactionType
  category    CreditTransactionCategory @default(CREDIT_PURCHASE)
  description String?
  createdAt   DateTime              @default(now())

  @@index([companyId])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  entityType    String?
  entityId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
}

// ----------------------------- New Models -----------------------------

model AssessmentTemplate {
  id                   String          @id @default(uuid())
  companyId            String?
  company              Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy            String?
  creator              User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  title                String
  description          String?
  durationMinutes      Int
  passingScore         Int             @default(0)
  maxAttempts          Int             @default(1)
  shuffleProblems      Boolean         @default(false)
  shuffleOptions       Boolean         @default(false)
  showResults          Boolean         @default(true)
  antiCheatingEnabled  Boolean         @default(true)
  resultStrategy       ResultStrategy  @default(LATEST_SCORE)
  accessLevel          AssessmentAccessLevel @default(INVITATION_ONLY)
  questionConfig       Json?
  skills               String[]        @default([])
  difficultyDistribution Json?
  antiCheatingSettings Json?
  status               TemplateStatus  @default(DRAFT)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  assessments  Assessment[]

  @@index([companyId])
  @@index([status])
}

model CandidateNote {
  id          String   @id @default(uuid())
  candidateId String
  candidate   User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment  Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  authorId    String
  author      User     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  content     String
  isPrivate   Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([candidateId])
  @@index([assessmentId])
  @@index([companyId])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  status        NotificationStatus @default(UNREAD)
  title         String
  message       String
  data          Json?
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId])
  @@index([status])
  @@index([type])
}

model AttemptSession {
  id           String   @id @default(uuid())
  attemptId    String
  attempt      Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sessionId    String
  ipAddress    String?
  userAgent    String?
  deviceInfo   String?
  startedAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  endedAt      DateTime?
  isSuspicious Boolean  @default(false)
  eventCount   Int      @default(0)

  @@unique([attemptId, sessionId])
  @@index([attemptId])
  @@index([sessionId])
  @@index([ipAddress])
}

// ----------------------------- Video Interview Models -----------------------------

/// A proctored, AI-reviewed video interview (audio + camera) created by a company.
model Interview {
  id                  String          @id @default(uuid())
  companyId           String?
  company             Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy           String
  creator             User            @relation("InterviewCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  title               String
  description         String?
  jobRole             String?
  /// Technology the questions are drawn from (e.g. "javascript", "react").
  technology          String
  seniority           String          @default("MID")
  /// Number of questions served to each candidate (random sample from the bank).
  questionCount       Int             @default(10)
  /// Seconds allowed per question. Default 5 minutes, configurable per interview.
  questionTimeSeconds Int             @default(300)
  /// Optional hard cap for the whole interview; null = questions * questionTimeSeconds.
  totalTimeSeconds    Int?
  shuffleQuestions    Boolean         @default(true)
  hintsEnabled        Boolean         @default(true)
  proctoringEnabled   Boolean         @default(true)
  /// Terminate + zero the session when a CRITICAL violation is detected.
  terminateOnCritical Boolean         @default(true)
  aiReviewEnabled     Boolean         @default(true)
  /// Percentage required to pass (mirrors Assessment.passingScore semantics).
  passScore           Int             @default(60)
  /// Non-critical violations tolerated before the session is flagged as high risk.
  maxViolations       Int             @default(2)
  /// Public link token — the candidate opens `/interview/<accessToken>`.
  accessToken         String          @unique
  status              InterviewStatus @default(DRAFT)
  /// When the candidate link becomes active (required at creation). Null = active as soon as published.
  startsAt            DateTime?
  /// When the exam closes to candidates (required at creation).
  expiresAt           DateTime?
  settings            Json?
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  questions InterviewQuestion[]
  sessions  InterviewSession[]

  @@index([companyId])
  @@index([status])
  @@index([technology])
  @@index([accessToken])
}

/// A single spoken question, from the built-in technology bank or written by the org.
model InterviewQuestion {
  id               String                  @id @default(uuid())
  interviewId      String
  interview        Interview               @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  order            Int
  prompt           String
  /// Progressive hints revealed by the candidate (requirement 11).
  hints            String[]                @default([])
  /// Keywords the AI rubric expects in a strong spoken answer.
  expectedKeywords String[]                @default([])
  modelAnswer      String?
  /// Optional per-question override of `Interview.questionTimeSeconds`.
  timeSeconds      Int?
  maxScore         Int                     @default(10)
  source           InterviewQuestionSource @default(BANK)
  /// Stable key of the source bank entry (null for custom questions).
  bankKey          String?
  difficulty       Difficulty              @default(MEDIUM)
  topic            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  answers InterviewAnswer[]

  @@index([interviewId])
  @@index([source])
}

/// One candidate's run through an interview, reached through the public link token.
model InterviewSession {
  id                String                 @id @default(uuid())
  interviewId       String
  interview         Interview              @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  candidateId       String?
  candidate         User?                  @relation("InterviewCandidate", fields: [candidateId], references: [id], onDelete: SetNull)
  /// Per-candidate secret embedded in the link (so the org can share one link per person).
  token             String                 @unique
  candidateName     String
  candidateEmail    String
  status            InterviewSessionStatus @default(NOT_STARTED)
  startedAt         DateTime?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  terminatedAt      DateTime?
  /// Why the session was ended early (proctoring violation, expiry, ...).
  terminationReason String?
  expiresAt         DateTime?
  ipAddress         String?
  userAgent         String?
  deviceInfo        Json?
  consentGivenAt    DateTime?
  /// When the invitation email (with the personal, secured exam link) was sent.
  emailSentAt       DateTime?
  /// Set once the invited email owner proved ownership of the address (link security).
  emailVerifiedAt   DateTime?
  /// SHA-256 hash of the 6-digit verification code emailed to the invited address.
  verificationCodeHash      String?
  verificationCodeExpiresAt DateTime?
  totalScore        Int                    @default(0)
  maxScore          Int                    @default(0)
  percentage        Float                  @default(0)
  passesInterview   Boolean                @default(false)
  /// 100 minus proctoring penalties — shown to the hiring team.
  integrityScore    Int                    @default(100)
  riskLevel         String                 @default("LOW")
  violationCount    Int                    @default(0)
  decision          InterviewDecision?
  aiSummary         String?
  aiStrengths       String[]               @default([])
  aiImprovements    String[]               @default([])
  aiReview          Json?
  /// "openai" | "rubric" — which engine produced the marks.
  reviewProvider    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  answers    InterviewAnswer[]
  violations InterviewViolation[]

  @@index([interviewId])
  @@index([candidateId])
  @@index([status])
  @@index([token])
}


/// The recorded answer for one question: transcript, telemetry and AI marks.
model InterviewAnswer {
  id               String            @id @default(uuid())
  sessionId        String
  session          InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId       String
  question         InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order            Int
  /// SUBMITTED | SKIPPED | AUTO_SUBMITTED | PENDING
  status           String            @default("PENDING")
  transcript       String?
  /// Optional pointer to externally stored media (org-configured object storage).
  recordingUrl     String?
  recordingMime    String?
  recordingSeconds Int?
  audioLevelAvg    Float?
  /// Per-question proctoring telemetry (face counts, brightness, noise samples).
  videoFrames      Json?
  /// Small evidence snapshots (base64 JPEG) captured by the candidate's browser.
  snapshots        Json?
  hintsUsed        Int               @default(0)
  hintsRevealed    String[]          @default([])
  timeSpentSeconds Int?
  startedAt        DateTime?
  submittedAt      DateTime?
  score            Int?
  maxScore         Int               @default(10)
  keywordHits      String[]          @default([])
  missingKeywords  String[]          @default([])
  aiFeedback       String?
  aiStrengths      String[]          @default([])
  aiImprovements   String[]          @default([])
  aiConfidence     Float?
  aiReview         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([sessionId, questionId])
  @@index([sessionId])
}

/// A proctoring signal captured during the interview (tab switch, device use, noise, ...).
model InterviewViolation {
  id          String                     @id @default(uuid())
  sessionId   String
  session     InterviewSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId  String?
  type        InterviewViolationType
  severity    InterviewViolationSeverity @default(MEDIUM)
  detectedBy  InterviewViolationDetector @default(CLIENT)
  description String?
  metadata    Json?
  /// Small base64 JPEG evidence frame (when the browser could capture one).
  snapshot    String?
  occurredAt  DateTime                   @default(now())

  @@index([sessionId])
  @@index([type])
  @@index([severity])
}

// ----------------------------- Resume builder & ATS analyzer -----------------------------

enum ResumeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnalysisSource {
  BUILDER
  UPLOAD
  URL
}

enum AnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

/// A structured resume owned by a user. `content` holds validated JSON (see
/// server/src/modules/resumes/resume.validation.ts for the shape).
model Resume {
  id             String       @id @default(uuid())
  ownerId        String
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title          String
  /// Target role label, e.g. "Full-Stack Engineer".
  targetRole     String?
  content        Json
  /// Template id from the frontend template registry (e.g. "ats-classic-01").
  templateId     String       @default("ats-classic-01")
  /// Font / accent color / spacing / section order overrides.
  customization  Json?
  status         ResumeStatus @default(DRAFT)
  /// Soft-delete so accidental deletes are recoverable.
  deletedAt      DateTime?
  /// Shareable public link controls.
  publicSlug     String?      @unique
  isPublic       Boolean      @default(false)
  /// Denormalized latest ATS score for dashboard display.
  latestScore    Int?
  lastAnalyzedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  versions ResumeVersion[]
  analyses ResumeAnalysis[]

  @@index([ownerId])
  @@index([ownerId, updatedAt])
  @@index([status])
  @@index([deletedAt])
}

/// Immutable snapshot created on demand or automatically on significant edits.
model ResumeVersion {
  id        String   @id @default(uuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  version   Int
  content   Json
  templateId String?
  /// Short human label, e.g. "Before tailoring to Acme Corp".
  label     String?
  createdAt DateTime @default(now())

  @@unique([resumeId, version])
  @@index([resumeId])
}

/// A saved job description used for resume-vs-job matching.
model JobDescription {
  id          String    @id @default(uuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  company     String?
  description String
  sourceUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  analyses ResumeAnalysis[]

  @@index([ownerId])
  @@index([deletedAt])
}

/// A persisted ATS/content analysis report. AI-generated part is stored in
/// `report`; `score` + `categoryScores` are denormalized for dashboards.
model ResumeAnalysis {
  id              String         @id @default(uuid())
  ownerId         String
  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  resumeId        String?
  resume          Resume?        @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobDescriptionId String?
  jobDescription  JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  source          AnalysisSource @default(BUILDER)
  status          AnalysisStatus @default(PENDING)
  /// Extracted plain text analysed (truncated server-side).
  resumeText      String?
  /// Original file metadata for uploads.
  fileName        String?
  fileMime        String?
  sourceUrl       String?
  /// 0..100 overall score.
  score           Int?
  categoryScores  Json?
  /// Full structured report (ATS, content, keywords, sections, action plan).
  report          Json?
  /// "openai" | "deterministic" — which engine produced the report.
  provider        String?
  error           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([ownerId])
  @@index([resumeId])
  @@index([status])
}

